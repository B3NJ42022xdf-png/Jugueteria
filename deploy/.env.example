# Variables de entorno de despliegue (copiar a /etc/mi-jugueteria.env)
# Nunca subas este archivo con secretos reales al repositorio.

NODE_ENV=production
HOST=0.0.0.0
PORT=3000
APP_VERSION=1.0.0

# Alertas: webhook de Slack para /api/alerts/test
ALERT_WEBHOOK_URL=

# Base de datos para los respaldos diarios
DATABASE_URL=postgres://jugueteria:password@127.0.0.1:5432/jugueteria
BACKUP_DIR=/var/backups/jugueteria
RETENTION_DAYS=14
# S3_BUCKET=mi-jugueteria-backups

# Monitoreo
UPTIMEROBOT_API_KEY=
UPTIMEROBOT_ALERT_CONTACTS=
NEW_RELIC_LICENSE_KEY=
NEW_RELIC_APP_NAME=Mi Juguetería

# Mantenimiento (se activa desde el timer o manualmente)
MAINTENANCE_MODE=false
