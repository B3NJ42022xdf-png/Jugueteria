/*
  Cache-Control para hosts estáticos (Netlify / Cloudflare Pages).
  Los archivos de /assets llevan hash: se pueden cachear un año.
  El HTML y el service worker siempre se revalidan.
*/
/assets/*
  Cache-Control: public, max-age=31536000, immutable

/index.html
  Cache-Control: no-cache

/sw.js
  Cache-Control: no-cache

/favicon.svg
  Cache-Control: public, max-age=604800
